# Modelo de lenguaje (app/llm.py). Solo nombres: los valores nunca van al repositorio.
CEM_LLM_PROVIDER=
CEM_LLM_API_KEY=
CEM_LLM_BASE_URL=
CEM_LLM_MODEL=

# Lectura del comprobante con IA, solo en cem-trabajos: apagada o encendida.
CEM_LECTURA_COMPROBANTES=apagada

# Dias que lo rechazado queda en la bandeja de pagos. Sin la variable, 7.
CEM_PAGOS_DIAS_BANDEJA=7

# Tope de un extracto para cotejar con el banco. Sin las variables, 20 MB y 50000 lineas.
CEM_COTEJO_TOPE_BYTES=20971520
CEM_COTEJO_MAXIMO_LINEAS=50000
