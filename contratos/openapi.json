{
  "components": {
    "schemas": {
      "ConsorcioResumen": {
        "description": "Un consorcio donde la persona tiene vínculo vigente (selector de edificio).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "vinculos": {
            "description": "Vínculos vigentes de la persona en él.",
            "items": {
              "$ref": "#/components/schemas/TipoVinculo"
            },
            "title": "Vinculos",
            "type": "array"
          }
        },
        "required": [
          "id",
          "nombre",
          "vinculos"
        ],
        "title": "ConsorcioResumen",
        "type": "object"
      },
      "EstadoCola": {
        "description": "Respuesta de `GET /api/v1/health/cola` (documento 13, §16.2 y §16.3).\n\nSolo totales: ningún dato de un consorcio. Kuma alerta cuando `estado` es `alerta`.",
        "properties": {
          "en_curso": {
            "title": "En Curso",
            "type": "integer"
          },
          "estado": {
            "description": "`alerta` si hay trabajos muertos o el pendiente más viejo espera más de 15 minutos.",
            "enum": [
              "ok",
              "alerta"
            ],
            "title": "Estado",
            "type": "string"
          },
          "muertos": {
            "title": "Muertos",
            "type": "integer"
          },
          "pendientes": {
            "title": "Pendientes",
            "type": "integer"
          },
          "segundos_mas_viejo": {
            "description": "Espera del pendiente listo más viejo.",
            "title": "Segundos Mas Viejo",
            "type": "number"
          }
        },
        "required": [
          "estado",
          "pendientes",
          "en_curso",
          "muertos",
          "segundos_mas_viejo"
        ],
        "title": "EstadoCola",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ListaUnidades": {
        "properties": {
          "elementos": {
            "items": {
              "$ref": "#/components/schemas/Unidad"
            },
            "title": "Elementos",
            "type": "array"
          }
        },
        "required": [
          "elementos"
        ],
        "title": "ListaUnidades",
        "type": "object"
      },
      "Salud": {
        "properties": {
          "estado": {
            "const": "ok",
            "title": "Estado",
            "type": "string"
          },
          "sha_contratos": {
            "title": "Sha Contratos",
            "type": "string"
          },
          "sha_imagen": {
            "title": "Sha Imagen",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "version_contrato": {
            "title": "Version Contrato",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "version",
          "sha_imagen",
          "sha_contratos",
          "version_contrato"
        ],
        "title": "Salud",
        "type": "object"
      },
      "TipoVinculo": {
        "description": "Relación de una persona con una unidad funcional.",
        "enum": [
          "propietario",
          "inquilino",
          "ocupante"
        ],
        "title": "TipoVinculo",
        "type": "string"
      },
      "Unidad": {
        "description": "Unidad funcional del padrón.",
        "properties": {
          "designacion": {
            "examples": [
              "3° B"
            ],
            "title": "Designacion",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "designacion"
        ],
        "title": "Unidad",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Consorcio en Mano",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/consorcios/{consorcio_id}/unidades": {
      "get": {
        "operationId": "unidades_api_v1_consorcios__consorcio_id__unidades_get",
        "parameters": [
          {
            "in": "path",
            "name": "consorcio_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Consorcio Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaUnidades"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unidades",
        "tags": [
          "consorcios"
        ]
      }
    },
    "/api/v1/health/cola": {
      "get": {
        "description": "Totales de la cola de trabajos para Kuma; sin datos de ningún consorcio.",
        "operationId": "salud_cola_api_v1_health_cola_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoCola"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Salud Cola",
        "tags": [
          "plataforma"
        ]
      }
    },
    "/api/v1/me/consorcios": {
      "get": {
        "description": "Consorcios donde la persona tiene al menos un vínculo vigente.",
        "operationId": "mis_consorcios_api_v1_me_consorcios_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConsorcioResumen"
                  },
                  "title": "Response Mis Consorcios Api V1 Me Consorcios Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mis Consorcios",
        "tags": [
          "consorcios"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "salud_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Salud",
        "tags": [
          "plataforma"
        ]
      }
    }
  }
}
