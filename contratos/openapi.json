{
  "components": {
    "schemas": {
      "CanjeCodigo": {
        "description": "`POST /api/v1/auth/codigo`: el correo y el código de seis dígitos que llegó en el mismo\ncorreo que el enlace. Sirve en cualquier dispositivo, no solo en el que pidió la entrada.\n\nVale 10 minutos y cinco intentos; solo el del último pedido. Usarlo gasta también el enlace\ndel mismo pedido, y al revés.",
        "properties": {
          "codigo": {
            "examples": [
              "042917"
            ],
            "pattern": "^[0-9]{6}$",
            "title": "Codigo",
            "type": "string"
          },
          "correo": {
            "examples": [
              "ana@ejemplo.com"
            ],
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Correo",
            "type": "string"
          }
        },
        "required": [
          "correo",
          "codigo"
        ],
        "title": "CanjeCodigo",
        "type": "object"
      },
      "CanjeEnlace": {
        "description": "`POST /api/v1/auth/canje`: el token que la página `/entrar` leyó del fragmento del enlace.\n\nVa en el cuerpo y no en la URL: así no queda en ningún registro de acceso ni en `Referer`.",
        "properties": {
          "token": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "CanjeEnlace",
        "type": "object"
      },
      "ConsorcioResumen": {
        "description": "Un consorcio donde la persona tiene vínculo vigente (selector de edificio).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "vinculos": {
            "description": "Vínculos vigentes de la persona en él.",
            "items": {
              "$ref": "#/components/schemas/TipoVinculo"
            },
            "title": "Vinculos",
            "type": "array"
          }
        },
        "required": [
          "id",
          "nombre",
          "vinculos"
        ],
        "title": "ConsorcioResumen",
        "type": "object"
      },
      "EnlacePedido": {
        "description": "Respuesta 202 del pedido de enlace: la misma exista o no la cuenta (§10.3).",
        "properties": {
          "estado": {
            "const": "pedido",
            "title": "Estado",
            "type": "string"
          },
          "mensaje": {
            "description": "Texto genérico para la persona usuaria.",
            "title": "Mensaje",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "mensaje"
        ],
        "title": "EnlacePedido",
        "type": "object"
      },
      "EstadoCola": {
        "description": "Respuesta de `GET /api/v1/health/cola` (documento 13, §16.2 y §16.3).\n\nSolo totales: ningún dato de un consorcio. Kuma alerta cuando `estado` es `alerta`.",
        "properties": {
          "en_curso": {
            "title": "En Curso",
            "type": "integer"
          },
          "estado": {
            "description": "`alerta` si hay trabajos muertos o el pendiente más viejo espera más de 15 minutos.",
            "enum": [
              "ok",
              "alerta"
            ],
            "title": "Estado",
            "type": "string"
          },
          "muertos": {
            "title": "Muertos",
            "type": "integer"
          },
          "pendientes": {
            "title": "Pendientes",
            "type": "integer"
          },
          "segundos_mas_viejo": {
            "description": "Espera del pendiente listo más viejo.",
            "title": "Segundos Mas Viejo",
            "type": "number"
          }
        },
        "required": [
          "estado",
          "pendientes",
          "en_curso",
          "muertos",
          "segundos_mas_viejo"
        ],
        "title": "EstadoCola",
        "type": "object"
      },
      "EstadoDependencia": {
        "enum": [
          "ok",
          "falla"
        ],
        "title": "EstadoDependencia",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ListaSesiones": {
        "description": "`GET /api/v1/auth/sesiones`: las sesiones vigentes, la de uso más reciente primero.",
        "properties": {
          "elementos": {
            "items": {
              "$ref": "#/components/schemas/SesionDispositivo"
            },
            "title": "Elementos",
            "type": "array"
          }
        },
        "required": [
          "elementos"
        ],
        "title": "ListaSesiones",
        "type": "object"
      },
      "ListaUnidades": {
        "properties": {
          "elementos": {
            "items": {
              "$ref": "#/components/schemas/Unidad"
            },
            "title": "Elementos",
            "type": "array"
          }
        },
        "required": [
          "elementos"
        ],
        "title": "ListaUnidades",
        "type": "object"
      },
      "PedidoEnlace": {
        "description": "`POST /api/v1/auth/enlace`: pide un enlace de acceso para ese correo.",
        "properties": {
          "correo": {
            "examples": [
              "ana@ejemplo.com"
            ],
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Correo",
            "type": "string"
          }
        },
        "required": [
          "correo"
        ],
        "title": "PedidoEnlace",
        "type": "object"
      },
      "Salud": {
        "description": "`GET /health`: el proceso vive. No consulta ninguna dependencia.",
        "properties": {
          "estado": {
            "const": "ok",
            "title": "Estado",
            "type": "string"
          },
          "sha_contratos": {
            "title": "Sha Contratos",
            "type": "string"
          },
          "sha_imagen": {
            "title": "Sha Imagen",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "version_contrato": {
            "title": "Version Contrato",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "version",
          "sha_imagen",
          "sha_contratos",
          "version_contrato"
        ],
        "title": "Salud",
        "type": "object"
      },
      "SaludDependencias": {
        "description": "`GET /api/v1/health/deps`: 200 si todas responden; 503 si alguna falla.\n\nKuma busca la palabra clave `\"db\":\"ok\"`. El motivo de una falla va a los registros,\nnunca a la respuesta. El almacén de objetos y el antivirus se suman cuando existan.",
        "properties": {
          "db": {
            "$ref": "#/components/schemas/EstadoDependencia"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoDependencia"
          },
          "redis": {
            "$ref": "#/components/schemas/EstadoDependencia"
          }
        },
        "required": [
          "estado",
          "db",
          "redis"
        ],
        "title": "SaludDependencias",
        "type": "object"
      },
      "SesionActual": {
        "description": "`GET /api/v1/auth/sesion` y respuesta del canje: quién es la persona de la sesión.",
        "properties": {
          "correo": {
            "title": "Correo",
            "type": "string"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "persona_id": {
            "format": "uuid",
            "title": "Persona Id",
            "type": "string"
          },
          "sesion_id": {
            "format": "uuid",
            "title": "Sesion Id",
            "type": "string"
          },
          "vence_en": {
            "description": "Vencimiento deslizante: cada uso de la sesión lo vuelve a correr.",
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "persona_id",
          "nombre",
          "correo",
          "sesion_id",
          "vence_en"
        ],
        "title": "SesionActual",
        "type": "object"
      },
      "SesionDispositivo": {
        "description": "Una sesión vigente de la persona, para listarla y revocarla (RF04, §10.4).\n\nNunca lleva el agente crudo ni la IP: quien tuviera una sesión robada vería, si no, la\nhuella del navegador y la dirección de los otros dispositivos de la persona.",
        "properties": {
          "actual": {
            "description": "Es la sesión de esta misma petición.",
            "title": "Actual",
            "type": "boolean"
          },
          "creada_en": {
            "format": "date-time",
            "title": "Creada En",
            "type": "string"
          },
          "dispositivo": {
            "description": "Descripción legible derivada del navegador, p. ej. «Chrome en Android».",
            "examples": [
              "Chrome en Android"
            ],
            "title": "Dispositivo",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ultimo_uso_en": {
            "description": "Se actualiza como mucho cada pocos minutos, no en cada petición.",
            "format": "date-time",
            "title": "Ultimo Uso En",
            "type": "string"
          },
          "vence_en": {
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "id",
          "dispositivo",
          "creada_en",
          "ultimo_uso_en",
          "vence_en",
          "actual"
        ],
        "title": "SesionDispositivo",
        "type": "object"
      },
      "SesionSoporte": {
        "description": "`GET /api/v1/soporte/sesion`: el operador según el JWT de Access verificado.",
        "properties": {
          "identidad": {
            "title": "Identidad",
            "type": "string"
          },
          "tipo": {
            "enum": [
              "persona",
              "servicio"
            ],
            "title": "Tipo",
            "type": "string"
          }
        },
        "required": [
          "identidad",
          "tipo"
        ],
        "title": "SesionSoporte",
        "type": "object"
      },
      "SesionesRevocadas": {
        "description": "`POST /api/v1/auth/sesiones/revocar-otras`: cuántas sesiones se cerraron.",
        "properties": {
          "revocadas": {
            "minimum": 0.0,
            "title": "Revocadas",
            "type": "integer"
          }
        },
        "required": [
          "revocadas"
        ],
        "title": "SesionesRevocadas",
        "type": "object"
      },
      "TipoVinculo": {
        "description": "Relación de una persona con una unidad funcional.",
        "enum": [
          "propietario",
          "inquilino",
          "ocupante"
        ],
        "title": "TipoVinculo",
        "type": "string"
      },
      "Unidad": {
        "description": "Unidad funcional del padrón.",
        "properties": {
          "designacion": {
            "examples": [
              "3° B"
            ],
            "title": "Designacion",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "designacion"
        ],
        "title": "Unidad",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Consorcio en Mano",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/canje": {
      "post": {
        "description": "Valida el token (existe, no venció, no se usó) y que el navegador tenga la cookie\n`nonce` con la que se pidió; crea la sesión y deja sus cookies. Todo rechazo responde\nigual: 401 `enlace_invalido`.\n\nSin token CSRF, porque todavía no hay sesión. La protección equivalente es el nonce: la\ncookie es `SameSite=Lax`, así que un `POST` desde otro sitio llega sin ella y se rechaza; y\naunque llegara, el token canjeado tendría que ser uno pedido desde este mismo navegador. Una\nfalsificación de inicio de sesión (meter a la víctima en la cuenta del atacante) necesita el\nnonce de la víctima ligado al token del atacante, y no lo tiene. Además, si el navegador\ndeclara `Sec-Fetch-Site` y no es `same-origin`, se rechaza.",
        "operationId": "canjear_api_v1_auth_canje_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CanjeEnlace"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionActual"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Canjear el enlace de acceso",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/codigo": {
      "post": {
        "description": "Entra con el correo y el código de seis dígitos del último pedido, desde cualquier\ndispositivo. Crea la sesión como el canje del enlace y gasta el pedido entero (el enlace\ndeja de servir). Todo rechazo responde igual, 401 `codigo_invalido`, y en el mismo tiempo,\nexista o no la cuenta.\n\nVale 10 minutos y cinco intentos fallidos; al quinto queda agotado aunque después llegue el\ncorrecto. Además, cada correo tiene un cupo de intentos (10 por hora, 20 por día) que no\ndepende de la IP.\n\nNo pide el `nonce`: sirve justamente en otro navegador. Lo que lo reemplaza contra una\nfalsificación de inicio de sesión desde otro sitio: `Sec-Fetch-Site` debe ser `same-origin`\nsi el navegador lo declara, y el cuerpo debe ser `application/json` (FastAPI 0.141 no\ninterpreta otro tipo ni un cuerpo sin tipo: 422), que un formulario de otro sitio no puede\nmandar y que desde `fetch` obliga a una consulta previa CORS que la API no autoriza. Lo\ndemás lo cubre que el código solo llega al correo de la persona.",
        "operationId": "canjear_codigo_api_v1_auth_codigo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CanjeCodigo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionActual"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "El código no sirve (todas las causas responden igual)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entrar con el código del correo",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/enlace": {
      "post": {
        "description": "Responde siempre 202 con el mismo cuerpo y en el mismo tiempo, exista o no la cuenta.\nDeja en el navegador la cookie `nonce` a la que queda ligado el enlace. El mismo correo\nlleva un código de seis dígitos para entrar desde otro dispositivo (`POST /codigo`).",
        "operationId": "pedir_enlace_api_v1_auth_enlace_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoEnlace"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnlacePedido"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pedir la entrada: enlace y código por correo",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/salir": {
      "post": {
        "description": "Revoca la sesión actual y borra sus cookies. Pide `X-CSRF-Token`.",
        "operationId": "salir_api_v1_auth_salir_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Cerrar la sesión",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/sesion": {
      "get": {
        "operationId": "sesion_actual_api_v1_auth_sesion_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionActual"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Quién soy",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/sesiones": {
      "get": {
        "description": "Las sesiones vigentes (ni vencidas ni revocadas) de la persona, con la actual marcada.\nEl dispositivo es una descripción del navegador; ni el agente crudo ni la IP salen.",
        "operationId": "listar_sesiones_api_v1_auth_sesiones_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaSesiones"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mis sesiones vigentes",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/sesiones/revocar-otras": {
      "post": {
        "description": "Revoca todas las sesiones vigentes de la persona menos la de esta petición.",
        "operationId": "revocar_otras_api_v1_auth_sesiones_revocar_otras_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionesRevocadas"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cerrar las sesiones de los otros dispositivos",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/auth/sesiones/{sesion_id}/revocar": {
      "post": {
        "description": "Revoca una sesión propia. Repetirlo responde lo mismo y conserva la fecha de la primera\nrevocación. Si es la actual, además borra sus cookies, como `salir`.",
        "operationId": "revocar_sesion_api_v1_auth_sesiones__sesion_id__revocar_post",
        "parameters": [
          {
            "in": "path",
            "name": "sesion_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Sesion Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "La sesión no existe o no es de la persona."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cerrar una sesión",
        "tags": [
          "identidad"
        ]
      }
    },
    "/api/v1/consorcios/{consorcio_id}/unidades": {
      "get": {
        "operationId": "unidades_api_v1_consorcios__consorcio_id__unidades_get",
        "parameters": [
          {
            "in": "path",
            "name": "consorcio_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Consorcio Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaUnidades"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unidades",
        "tags": [
          "consorcios"
        ]
      }
    },
    "/api/v1/health/cola": {
      "get": {
        "description": "Totales de la cola de trabajos para Kuma; sin datos de ningún consorcio.",
        "operationId": "salud_cola_api_v1_health_cola_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoCola"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Salud Cola",
        "tags": [
          "plataforma"
        ]
      }
    },
    "/api/v1/health/deps": {
      "get": {
        "description": "PostgreSQL (`select 1` con `cem_app`) y Redis (`PING`).",
        "operationId": "dependencias_api_v1_health_deps_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaludDependencias"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaludDependencias"
                }
              }
            },
            "description": "Alguna dependencia falla"
          }
        },
        "summary": "Dependencias",
        "tags": [
          "plataforma"
        ]
      }
