{
  "AceptacionInvitacion": {
    "description": "`POST /api/v1/auth/invitacion/aceptar`.",
    "properties": {
      "nombre": {
        "anyOf": [
          {
            "maxLength": 100,
            "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Solo para una cuenta nueva: el nombre con que queda. Sin él, el de la invitación. Una cuenta que ya existe conserva el suyo.",
        "title": "Nombre"
      },
      "token": {
        "pattern": "^[A-Za-z0-9_-]{43}$",
        "title": "Token",
        "type": "string"
      }
    },
    "required": [
      "token"
    ],
    "title": "AceptacionInvitacion",
    "type": "object"
  },
  "AltaTotp": {
    "description": "Respuesta de `POST /api/v1/auth/totp/alta`: el secreto para cargar en la aplicación.\n\nSe muestra una sola vez y queda pendiente hasta que la persona lo confirme con un código.",
    "properties": {
      "secreto": {
        "description": "Base32 sin relleno, para escribirlo a mano.",
        "title": "Secreto",
        "type": "string"
      },
      "uri": {
        "description": "`otpauth://totp/…` para abrir la aplicación o dibujar un código QR.",
        "examples": [
          "otpauth://totp/Consorcio%20en%20Mano:ana%40ejemplo.com?secret=…"
        ],
        "title": "Uri",
        "type": "string"
      }
    },
    "required": [
      "secreto",
      "uri"
    ],
    "title": "AltaTotp",
    "type": "object"
  },
  "CanjeCodigo": {
    "description": "`POST /api/v1/auth/codigo`: el correo y el código de seis dígitos que llegó en el mismo\ncorreo que el enlace. Sirve en cualquier dispositivo, no solo en el que pidió la entrada.\n\nVale 10 minutos y cinco intentos; solo el del último pedido. Usarlo gasta también el enlace\ndel mismo pedido, y al revés.",
    "properties": {
      "codigo": {
        "examples": [
          "042917"
        ],
        "pattern": "^[0-9]{6}$",
        "title": "Codigo",
        "type": "string"
      },
      "correo": {
        "examples": [
          "ana@ejemplo.com"
        ],
        "maxLength": 254,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "title": "Correo",
        "type": "string"
      }
    },
    "required": [
      "correo",
      "codigo"
    ],
    "title": "CanjeCodigo",
    "type": "object"
  },
  "CanjeEnlace": {
    "description": "`POST /api/v1/auth/canje`: el token que la página `/entrar` leyó del fragmento del enlace.\n\nVa en el cuerpo y no en la URL: así no queda en ningún registro de acceso ni en `Referer`.",
    "properties": {
      "token": {
        "pattern": "^[A-Za-z0-9_-]{43}$",
        "title": "Token",
        "type": "string"
      }
    },
    "required": [
      "token"
    ],
    "title": "CanjeEnlace",
    "type": "object"
  },
  "CodigoEntrada": {
    "description": "`POST /api/v1/auth/contrasena/segundo-factor`: el código de la aplicación o uno de\nrecuperación (que queda gastado).",
    "properties": {
      "codigo": {
        "examples": [
          "042917",
          "k7m2q-x9p4t"
        ],
        "pattern": "^[0-9]{6}$|^[a-z2-9]{5}-[a-z2-9]{5}$",
        "title": "Codigo",
        "type": "string"
      }
    },
    "required": [
      "codigo"
    ],
    "title": "CodigoEntrada",
    "type": "object"
  },
  "CodigoTotp": {
    "description": "`POST /api/v1/auth/totp/confirmar` y `POST /api/v1/auth/totp/baja`.",
    "properties": {
      "codigo": {
        "examples": [
          "042917"
        ],
        "pattern": "^[0-9]{6}$",
        "title": "Codigo",
        "type": "string"
      }
    },
    "required": [
      "codigo"
    ],
    "title": "CodigoTotp",
    "type": "object"
  },
  "CodigosRecuperacion": {
    "description": "Respuesta de `POST /api/v1/auth/totp/confirmar`: se muestran una sola vez.",
    "properties": {
      "codigos": {
        "items": {
          "type": "string"
        },
        "maxItems": 10,
        "minItems": 10,
        "title": "Codigos",
        "type": "array"
      }
    },
    "required": [
      "codigos"
    ],
    "title": "CodigosRecuperacion",
    "type": "object"
  },
  "ConsorcioResumen": {
    "$defs": {
      "TipoVinculo": {
        "description": "Relación de una persona con una unidad funcional.",
        "enum": [
          "propietario",
          "inquilino",
          "ocupante"
        ],
        "title": "TipoVinculo",
        "type": "string"
      }
    },
    "description": "Un consorcio donde la persona tiene vínculo vigente (selector de edificio).",
    "properties": {
      "id": {
        "format": "uuid",
        "title": "Id",
        "type": "string"
      },
      "nombre": {
        "title": "Nombre",
        "type": "string"
      },
      "vinculos": {
        "description": "Vínculos vigentes de la persona en él.",
        "items": {
          "$ref": "#/$defs/TipoVinculo"
        },
        "title": "Vinculos",
        "type": "array"
      }
    },
    "required": [
      "id",
      "nombre",
      "vinculos"
    ],
    "title": "ConsorcioResumen",
    "type": "object"
  },
  "ContrasenaGuardada": {
    "description": "Respuesta de `PUT /api/v1/auth/contrasena`.",
    "properties": {
      "cambiada_en": {
        "format": "date-time",
        "title": "Cambiada En",
        "type": "string"
      },
      "sesiones_cerradas": {
        "description": "Al cambiar una contraseña existente se cierran las sesiones de los otros dispositivos; al definirla por primera vez, ninguna.",
        "minimum": 0,
        "title": "Sesiones Cerradas",
        "type": "integer"
      }
    },
    "required": [
      "cambiada_en",
      "sesiones_cerradas"
    ],
    "title": "ContrasenaGuardada",
    "type": "object"
  },
  "EnlacePedido": {
    "description": "Respuesta 202 del pedido de enlace: la misma exista o no la cuenta (§10.3).",
    "properties": {
      "estado": {
        "const": "pedido",
        "title": "Estado",
        "type": "string"
      },
      "mensaje": {
        "description": "Texto genérico para la persona usuaria.",
        "title": "Mensaje",
        "type": "string"
      }
    },
    "required": [
      "estado",
      "mensaje"
    ],
    "title": "EnlacePedido",
    "type": "object"
  },
  "EntradaContrasena": {
    "description": "`POST /api/v1/auth/contrasena/entrar`.",
    "properties": {
      "contrasena": {
        "format": "password",
        "maxLength": 128,
        "minLength": 1,
        "title": "Contrasena",
        "type": "string",
        "writeOnly": true
      },
      "correo": {
        "examples": [
          "ana@ejemplo.com"
        ],
        "maxLength": 254,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "title": "Correo",
        "type": "string"
      }
    },
    "required": [
      "correo",
      "contrasena"
    ],
    "title": "EntradaContrasena",
    "type": "object"
  },
  "Error": {
    "$defs": {
      "CodigoError": {
        "description": "Identificadores estables que el frontend traduce. Nunca cambian de significado.",
        "enum": [
          "no_autenticado",
          "no_encontrado",
          "peticion_invalida",
          "demasiadas_peticiones",
          "error_interno",
          "servicio_no_disponible",
          "idempotencia_reutilizada",
          "idempotencia_en_curso",
          "enlace_invalido",
          "codigo_invalido",
          "csrf_invalido",
          "sin_permiso",
          "invitacion_invalida",
          "invitacion_requiere_sesion",
          "invitacion_de_otra_persona",
          "invitacion_no_pendiente",
          "segundo_factor_requerido",
          "segundo_factor_invalido",
          "segundo_factor_ya_activo",
          "segundo_factor_sin_alta",
          "credenciales_invalidas",
          "entrada_vencida",
          "contrasena_actual_invalida",
          "contrasena_debil"
        ],
        "title": "CodigoError",
        "type": "string"
      }
    },
    "properties": {
      "codigo": {
        "$ref": "#/$defs/CodigoError"
      },
      "detalle": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Detalle"
      },
      "id_correlacion": {
        "description": "Identificador para cruzar con los registros.",
        "title": "Id Correlacion",
        "type": "string"
      },
      "mensaje": {
        "description": "Texto genérico para la persona usuaria; sin trazas.",
        "title": "Mensaje",
        "type": "string"
      }
    },
    "required": [
      "codigo",
      "mensaje",
      "id_correlacion"
    ],
    "title": "Error",
    "type": "object"
  },
  "EstadoCola": {
    "description": "Respuesta de `GET /api/v1/health/cola` (documento 13, §16.2 y §16.3).\n\nSolo totales: ningún dato de un consorcio. Kuma alerta cuando `estado` es `alerta`.",
    "properties": {
      "en_curso": {
        "title": "En Curso",
        "type": "integer"
      },
      "estado": {
        "description": "`alerta` si hay trabajos muertos o el pendiente más viejo espera más de 15 minutos.",
        "enum": [
          "ok",
          "alerta"
        ],
        "title": "Estado",
        "type": "string"
      },
      "muertos": {
        "title": "Muertos",
        "type": "integer"
      },
      "pendientes": {
        "title": "Pendientes",
        "type": "integer"
      },
      "segundos_mas_viejo": {
        "description": "Espera del pendiente listo más viejo.",
        "title": "Segundos Mas Viejo",
        "type": "number"
      }
    },
    "required": [
      "estado",
      "pendientes",
      "en_curso",
      "muertos",
      "segundos_mas_viejo"
    ],
    "title": "EstadoCola",
    "type": "object"
  },
  "EstadoContrasena": {
    "description": "`GET /api/v1/auth/contrasena`.",
    "properties": {
      "cambiada_en": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cambiada En"
      },
      "definida": {
        "title": "Definida",
        "type": "boolean"
      }
    },
    "required": [
      "definida"
    ],
    "title": "EstadoContrasena",
    "type": "object"
  },
  "EstadoSegundoFactor": {
    "description": "`GET /api/v1/auth/totp`.",
    "properties": {
      "activado_en": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Activado En"
      },
      "activo": {
        "description": "Tiene una aplicación de autenticación confirmada.",
        "title": "Activo",
        "type": "boolean"
      },
      "codigos_recuperacion_restantes": {
        "minimum": 0,
        "title": "Codigos Recuperacion Restantes",
        "type": "integer"
      },
      "verificado_en": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Última verificación del segundo factor en esta sesión.",
        "title": "Verificado En"
      }
    },
    "required": [
      "activo",
      "codigos_recuperacion_restantes",
      "verificado_en"
    ],
    "title": "EstadoSegundoFactor",
    "type": "object"
  },
  "FaltaSegundoFactor": {
    "description": "La contraseña sirvió y la persona tiene segundo factor: falta el código\n(`POST /api/v1/auth/contrasena/segundo-factor`) desde el mismo navegador, antes de\n`vence_en`.",
    "properties": {
      "estado": {
        "const": "falta_segundo_factor",
        "title": "Estado",
        "type": "string"
      },
      "vence_en": {
        "format": "date-time",
        "title": "Vence En",
        "type": "string"
      }
    },
    "required": [
      "estado",
      "vence_en"
    ],
    "title": "FaltaSegundoFactor",
    "type": "object"
  },
  "Invitacion": {
    "$defs": {
      "EstadoInvitacion": {
        "enum": [
          "pendiente",
          "aceptada",
          "vencida",
          "revocada"
        ],
        "title": "EstadoInvitacion",
        "type": "string"
      },
      "TipoVinculo": {
        "description": "Relación de una persona con una unidad funcional.",
        "enum": [
          "propietario",
          "inquilino",
          "ocupante"
        ],
        "title": "TipoVinculo",
        "type": "string"
      }
    },
    "description": "Una invitación, como la ve quien puede invitar en esa unidad.",
    "properties": {
      "aceptada_en": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Aceptada En"
      },
      "correo": {
        "title": "Correo",
        "type": "string"
      },
      "creada_en": {
        "format": "date-time",
        "title": "Creada En",
        "type": "string"
      },
      "estado": {
        "$ref": "#/$defs/EstadoInvitacion"
      },
      "id": {
        "format": "uuid",
        "title": "Id",
        "type": "string"
      },
      "nombre": {
        "title": "Nombre",
        "type": "string"
      },
      "revocada_en": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Revocada En"
      },
      "tipo": {
        "$ref": "#/$defs/TipoVinculo"
      },
      "unidad": {
        "description": "Designación de la unidad.",
        "examples": [
          "3° B"
        ],
        "title": "Unidad",
        "type": "string"
      },
      "unidad_id": {
        "format": "uuid",
        "title": "Unidad Id",
        "type": "string"
      },
      "vence_en": {
        "format": "date-time",
        "title": "Vence En",
        "type": "string"
      }
    },
    "required": [
      "id",
      "unidad_id",
      "unidad",
      "tipo",
      "correo",
      "nombre",
      "estado",
      "creada_en",
      "vence_en"
    ],
    "title": "Invitacion",
    "type": "object"
  },
  "InvitacionAceptada": {
