  "SesionesRevocadas": {
    "description": "`POST /api/v1/auth/sesiones/revocar-otras`: cuántas sesiones se cerraron.",
    "properties": {
      "revocadas": {
        "minimum": 0,
        "title": "Revocadas",
        "type": "integer"
      }
    },
    "required": [
      "revocadas"
    ],
    "title": "SesionesRevocadas",
    "type": "object"
  },
  "TokenInvitacion": {
    "description": "`POST /api/v1/auth/invitacion/consultar`: el token que la página `/invitacion` leyó del\nfragmento del enlace. Va en el cuerpo, nunca en la URL.",
    "properties": {
      "token": {
        "pattern": "^[A-Za-z0-9_-]{43}$",
        "title": "Token",
        "type": "string"
      }
    },
    "required": [
      "token"
    ],
    "title": "TokenInvitacion",
    "type": "object"
  },
