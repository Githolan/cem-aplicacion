{
  "ConsorcioResumen": {
    "$defs": {
      "TipoVinculo": {
        "description": "Relación de una persona con una unidad funcional.",
        "enum": [
          "propietario",
          "inquilino",
          "ocupante"
        ],
        "title": "TipoVinculo",
        "type": "string"
      }
    },
    "description": "Un consorcio donde la persona tiene vínculo vigente (selector de edificio).",
    "properties": {
      "id": {
        "format": "uuid",
        "title": "Id",
        "type": "string"
      },
      "nombre": {
        "title": "Nombre",
        "type": "string"
      },
      "vinculos": {
        "description": "Vínculos vigentes de la persona en él.",
        "items": {
          "$ref": "#/$defs/TipoVinculo"
        },
        "title": "Vinculos",
        "type": "array"
      }
    },
    "required": [
      "id",
      "nombre",
      "vinculos"
    ],
    "title": "ConsorcioResumen",
    "type": "object"
  },
  "Error": {
    "$defs": {
      "CodigoError": {
        "description": "Identificadores estables que el frontend traduce. Nunca cambian de significado.",
        "enum": [
          "no_autenticado",
          "no_encontrado",
          "peticion_invalida",
          "demasiadas_peticiones",
          "error_interno",
          "servicio_no_disponible"
        ],
        "title": "CodigoError",
        "type": "string"
      }
    },
    "properties": {
      "codigo": {
        "$ref": "#/$defs/CodigoError"
      },
      "detalle": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Detalle"
      },
      "id_correlacion": {
        "description": "Identificador para cruzar con los registros.",
        "title": "Id Correlacion",
        "type": "string"
      },
      "mensaje": {
        "description": "Texto genérico para la persona usuaria; sin trazas.",
        "title": "Mensaje",
        "type": "string"
      }
    },
    "required": [
      "codigo",
      "mensaje",
      "id_correlacion"
    ],
    "title": "Error",
    "type": "object"
  },
  "EstadoCola": {
    "description": "Respuesta de `GET /api/v1/health/cola` (documento 13, §16.2 y §16.3).\n\nSolo totales: ningún dato de un consorcio. Kuma alerta cuando `estado` es `alerta`.",
    "properties": {
      "en_curso": {
        "title": "En Curso",
        "type": "integer"
      },
      "estado": {
        "description": "`alerta` si hay trabajos muertos o el pendiente más viejo espera más de 15 minutos.",
        "enum": [
          "ok",
          "alerta"
        ],
        "title": "Estado",
        "type": "string"
      },
      "muertos": {
        "title": "Muertos",
        "type": "integer"
      },
      "pendientes": {
        "title": "Pendientes",
        "type": "integer"
      },
      "segundos_mas_viejo": {
        "description": "Espera del pendiente listo más viejo.",
        "title": "Segundos Mas Viejo",
        "type": "number"
      }
    },
    "required": [
      "estado",
      "pendientes",
      "en_curso",
      "muertos",
      "segundos_mas_viejo"
    ],
    "title": "EstadoCola",
    "type": "object"
  },
  "ListaUnidades": {
    "$defs": {
      "Unidad": {
        "description": "Unidad funcional del padrón.",
        "properties": {
          "designacion": {
            "examples": [
              "3° B"
            ],
            "title": "Designacion",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "designacion"
        ],
        "title": "Unidad",
        "type": "object"
      }
    },
    "properties": {
      "elementos": {
        "items": {
          "$ref": "#/$defs/Unidad"
        },
        "title": "Elementos",
        "type": "array"
      }
    },
    "required": [
      "elementos"
    ],
    "title": "ListaUnidades",
    "type": "object"
  },
  "Salud": {
    "description": "`GET /health`: el proceso vive. No consulta ninguna dependencia.",
    "properties": {
      "estado": {
        "const": "ok",
        "title": "Estado",
        "type": "string"
      },
      "sha_contratos": {
        "title": "Sha Contratos",
        "type": "string"
      },
      "sha_imagen": {
        "title": "Sha Imagen",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
      "version_contrato": {
        "title": "Version Contrato",
        "type": "string"
      }
    },
    "required": [
      "estado",
      "version",
      "sha_imagen",
      "sha_contratos",
      "version_contrato"
    ],
    "title": "Salud",
    "type": "object"
  },
  "SaludDependencias": {
    "$defs": {
      "EstadoDependencia": {
        "enum": [
          "ok",
          "falla"
        ],
        "title": "EstadoDependencia",
        "type": "string"
      }
    },
    "description": "`GET /api/v1/health/deps`: 200 si todas responden; 503 si alguna falla.\n\nKuma busca la palabra clave `\"db\":\"ok\"`. El motivo de una falla va a los registros,\nnunca a la respuesta. El almacén de objetos y el antivirus se suman cuando existan.",
    "properties": {
      "db": {
        "$ref": "#/$defs/EstadoDependencia"
      },
      "estado": {
        "$ref": "#/$defs/EstadoDependencia"
      },
      "redis": {
        "$ref": "#/$defs/EstadoDependencia"
      }
    },
    "required": [
      "estado",
      "db",
      "redis"
    ],
    "title": "SaludDependencias",
    "type": "object"
  },
  "SesionSoporte": {
    "description": "`GET /api/v1/soporte/sesion`: el operador según el JWT de Access verificado.",
    "properties": {
      "identidad": {
        "title": "Identidad",
        "type": "string"
      },
      "tipo": {
        "enum": [
          "persona",
          "servicio"
        ],
        "title": "Tipo",
        "type": "string"
      }
    },
    "required": [
      "identidad",
      "tipo"
    ],
    "title": "SesionSoporte",
    "type": "object"
  },
  "Unidad": {
    "description": "Unidad funcional del padrón.",
    "properties": {
      "designacion": {
        "examples": [
          "3° B"
        ],
        "title": "Designacion",
        "type": "string"
      },
      "id": {
        "format": "uuid",
        "title": "Id",
        "type": "string"
      }
    },
    "required": [
      "id",
      "designacion"
    ],
    "title": "Unidad",
    "type": "object"
  }
}
