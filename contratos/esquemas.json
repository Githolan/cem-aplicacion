  "ListaSesiones": {
    "$defs": {
      "SesionDispositivo": {
        "description": "Una sesión vigente de la persona, para listarla y revocarla (RF04, §10.4).\n\nNunca lleva el agente crudo ni la IP: quien tuviera una sesión robada vería, si no, la\nhuella del navegador y la dirección de los otros dispositivos de la persona.",
        "properties": {
          "actual": {
            "description": "Es la sesión de esta misma petición.",
            "title": "Actual",
            "type": "boolean"
          },
          "creada_en": {
            "format": "date-time",
            "title": "Creada En",
            "type": "string"
          },
          "dispositivo": {
            "description": "Descripción legible derivada del navegador, p. ej. «Chrome en Android».",
            "examples": [
              "Chrome en Android"
            ],
            "title": "Dispositivo",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ultimo_uso_en": {
            "description": "Se actualiza como mucho cada pocos minutos, no en cada petición.",
            "format": "date-time",
            "title": "Ultimo Uso En",
            "type": "string"
          },
          "vence_en": {
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "id",
          "dispositivo",
          "creada_en",
          "ultimo_uso_en",
          "vence_en",
          "actual"
        ],
        "title": "SesionDispositivo",
        "type": "object"
      }
    },
    "description": "`GET /api/v1/auth/sesiones`: las sesiones vigentes, la de uso más reciente primero.",
    "properties": {
      "elementos": {
        "items": {
          "$ref": "#/$defs/SesionDispositivo"
        },
        "title": "Elementos",
        "type": "array"
      }
    },
    "required": [
      "elementos"
    ],
    "title": "ListaSesiones",
    "type": "object"
  },
  "ListaUnidades": {
    "$defs": {
      "Unidad": {
        "description": "Unidad funcional del padrón.",
        "properties": {
          "designacion": {
            "examples": [
              "3° B"
            ],
            "title": "Designacion",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "designacion"
        ],
        "title": "Unidad",
        "type": "object"
      }
    },
    "properties": {
      "elementos": {
        "items": {
          "$ref": "#/$defs/Unidad"
        },
        "title": "Elementos",
        "type": "array"
      }
    },
    "required": [
      "elementos"
    ],
    "title": "ListaUnidades",
    "type": "object"
  },
  "NuevaContrasena": {
    "description": "`PUT /api/v1/auth/contrasena`: definir o cambiar la contraseña.\n\nCon el segundo factor activo, la sesión tiene que haberlo verificado en los últimos 10\nminutos (TB-CEM-3). Sin segundo factor, cambiar una contraseña existente pide la actual.",
    "properties": {
      "contrasena_actual": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "format": "password",
        "title": "Contrasena Actual",
        "writeOnly": true
      },
      "contrasena_nueva": {
        "format": "password",
        "maxLength": 128,
        "minLength": 12,
        "title": "Contrasena Nueva",
        "type": "string",
        "writeOnly": true
      }
    },
    "required": [
      "contrasena_nueva"
    ],
    "title": "NuevaContrasena",
    "type": "object"
  },
  "PedidoEnlace": {
    "description": "`POST /api/v1/auth/enlace`: pide un enlace de acceso para ese correo.",
    "properties": {
      "correo": {
        "examples": [
          "ana@ejemplo.com"
        ],
        "maxLength": 254,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "title": "Correo",
        "type": "string"
      }
    },
    "required": [
      "correo"
    ],
    "title": "PedidoEnlace",
    "type": "object"
  },
  "Salud": {
    "description": "`GET /health`: el proceso vive. No consulta ninguna dependencia.",
    "properties": {
      "estado": {
        "const": "ok",
        "title": "Estado",
        "type": "string"
      },
      "sha_contratos": {
        "title": "Sha Contratos",
        "type": "string"
      },
      "sha_imagen": {
        "title": "Sha Imagen",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
      "version_contrato": {
        "title": "Version Contrato",
        "type": "string"
      }
    },
    "required": [
      "estado",
      "version",
      "sha_imagen",
      "sha_contratos",
      "version_contrato"
    ],
    "title": "Salud",
    "type": "object"
  },
  "SaludDependencias": {
    "$defs": {
      "EstadoDependencia": {
        "enum": [
          "ok",
          "falla"
        ],
        "title": "EstadoDependencia",
        "type": "string"
      }
    },
    "description": "`GET /api/v1/health/deps`: 200 si todas responden; 503 si alguna falla.\n\nKuma busca la palabra clave `\"db\":\"ok\"`. El motivo de una falla va a los registros,\nnunca a la respuesta. El almacén de objetos y el antivirus se suman cuando existan.",
    "properties": {
      "db": {
        "$ref": "#/$defs/EstadoDependencia"
      },
      "estado": {
        "$ref": "#/$defs/EstadoDependencia"
      },
      "redis": {
        "$ref": "#/$defs/EstadoDependencia"
      }
    },
    "required": [
      "estado",
      "db",
      "redis"
    ],
    "title": "SaludDependencias",
    "type": "object"
  },
  "SegundoFactorVerificado": {
    "description": "Respuesta de `POST /api/v1/auth/totp/verificar`.",
    "properties": {
      "codigos_recuperacion_restantes": {
        "minimum": 0,
        "title": "Codigos Recuperacion Restantes",
        "type": "integer"
      },
      "vale_hasta": {
        "description": "Hasta cuándo cuenta como reciente (10 minutos).",
        "format": "date-time",
        "title": "Vale Hasta",
        "type": "string"
      },
      "verificado_en": {
        "format": "date-time",
        "title": "Verificado En",
        "type": "string"
      }
    },
    "required": [
      "verificado_en",
      "vale_hasta",
      "codigos_recuperacion_restantes"
    ],
    "title": "SegundoFactorVerificado",
    "type": "object"
  },
  "SesionAbierta": {
    "$defs": {
      "SesionActual": {
        "description": "`GET /api/v1/auth/sesion` y respuesta del canje: quién es la persona de la sesión.",
        "properties": {
          "correo": {
            "title": "Correo",
            "type": "string"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "persona_id": {
            "format": "uuid",
            "title": "Persona Id",
            "type": "string"
          },
          "sesion_id": {
            "format": "uuid",
            "title": "Sesion Id",
            "type": "string"
          },
          "vence_en": {
            "description": "Vencimiento deslizante: cada uso de la sesión lo vuelve a correr.",
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "persona_id",
          "nombre",
          "correo",
          "sesion_id",
          "vence_en"
        ],
        "title": "SesionActual",
        "type": "object"
      }
    },
    "description": "La contraseña sirvió y la persona no tiene segundo factor: la sesión ya está abierta.",
    "properties": {
      "estado": {
        "const": "sesion_abierta",
        "title": "Estado",
        "type": "string"
      },
      "sesion": {
        "$ref": "#/$defs/SesionActual"
      }
    },
    "required": [
      "estado",
      "sesion"
    ],
    "title": "SesionAbierta",
    "type": "object"
  },
  "SesionActual": {
    "description": "`GET /api/v1/auth/sesion` y respuesta del canje: quién es la persona de la sesión.",
    "properties": {
      "correo": {
        "title": "Correo",
        "type": "string"
      },
      "nombre": {
        "title": "Nombre",
        "type": "string"
      },
      "persona_id": {
        "format": "uuid",
        "title": "Persona Id",
        "type": "string"
      },
      "sesion_id": {
        "format": "uuid",
        "title": "Sesion Id",
        "type": "string"
      },
      "vence_en": {
        "description": "Vencimiento deslizante: cada uso de la sesión lo vuelve a correr.",
        "format": "date-time",
        "title": "Vence En",
        "type": "string"
      }
    },
    "required": [
