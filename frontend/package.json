{
  "name": "cem-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicación web instalable (PWA) de Consorcio en Mano",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "generar": "openapi-typescript ../contratos/openapi.json -o src/api/tipos.ts",
    "dev": "pnpm generar && vite",
    "tipos": "pnpm generar && tsc -b && tsc -p e2e",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm generar && vitest run",
    "build": "pnpm generar && tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "pnpm generar && sh scripts/probar-extremo-a-extremo.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.57.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "2.1.9",
    "workbox-window": "7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
