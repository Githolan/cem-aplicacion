# nginx de cem-frontend (documento 13, §14.5, AD-05). La imagen oficial de nginx reemplaza
# ${CEM_BACKEND_DESTINO} al arrancar (envsubst sobre /etc/nginx/templates); el resto de las
# variables con $ son de nginx y quedan intactas.

# Detrás de Cloudflare y Traefik el esquema real llega en X-Forwarded-Proto.
map $http_x_forwarded_proto $esquema_original {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# IP real del cliente para el límite de tasa del backend (documento 13, §10.6; TB-8). Traefik no
# confía en encabezados reenviados: en X-Forwarded-For deja la IP de cloudflared (10.0.2.1 para
# todos, medido el 14-10-2026). La real llega en CF-Connecting-IP; sin ella (sondas internas que
# no pasan por Cloudflare) va la IP de quien llama.
map $http_cf_connecting_ip $ip_cliente {
    default $http_cf_connecting_ip;
    ""      $remote_addr;
}

# Registro de acceso sin la consulta (documento 13, §16.1): el `main` de la imagen escribe
# "$request", que incluye `?…`, y ahí puede haber un token o un correo. Se registra solo la ruta
# original (antes de cualquier try_files), sin `Referer`, que también puede traer una consulta.
# El enlace de acceso lleva el token en el fragmento (`/entrar#token=…`), que nunca llega acá;
# esto es la segunda barrera.
map $request_uri $ruta_sin_consulta {
    "~^(?<ruta>[^?]*)" $ruta;
}
log_format cem_sin_consulta '$remote_addr [$time_local] "$request_method $ruta_sin_consulta '
                            '$server_protocol" $status $body_bytes_sent $request_time '
                            '"$http_user_agent"';

server {
    access_log /var/log/nginx/access.log cem_sin_consulta;

    # 8080 porque nginx corre sin privilegios (uid 101). Solo IPv4, como uvicorn en cem-backend:
    # Traefik llega por la IPv4 del contenedor y un listen [::] impide arrancar donde no hay IPv6.
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # AD-05: el nombre del backend va en una variable, así nginx lo vuelve a resolver con el
    # DNS de Docker cada 10 s y un redespliegue del backend (IP nueva) no deja 502 persistentes.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend "${CEM_BACKEND_DESTINO}";

    include /etc/nginx/cem/cabeceras.conf;

    location /api/ {
        include /etc/nginx/cem/cabeceras.conf;
        include /etc/nginx/cem/proxy.conf;
    }

    location = /health {
        include /etc/nginx/cem/cabeceras.conf;
        include /etc/nginx/cem/proxy.conf;
    }

    # Activos con hash en el nombre: inmutables un año (§14.4). Sin "always", para que un 404
    # no quede guardado un año en el navegador ni en Cloudflare.
    location /assets/ {
        include /etc/nginx/cem/cabeceras.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # El service worker y el manifiesto se revalidan siempre, si no la versión nueva no llega.
    location ~ ^/(sw\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ {
        include /etc/nginx/cem/cabeceras.conf;
        add_header Cache-Control "no-cache" always;
        types {
            application/javascript js;
            application/manifest+json webmanifest;
        }
        try_files $uri =404;
    }

    # Comprobación de salud del propio contenedor: no depende del backend.
    location = /frontend-salud {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Aplicación de una sola página: toda otra ruta devuelve index.html sin caché.
    location / {
        include /etc/nginx/cem/cabeceras.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
